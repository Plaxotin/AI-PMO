# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Telegram (server-side only; never expose these values to the browser) ──
TELEGRAM_BOT_TOKEN=       # Token from @BotFather
TELEGRAM_WEBHOOK_SECRET=  # Random secret for x-telegram-bot-api-secret-token
TELEGRAM_PROJECT_CHAT_IDS= # Comma-separated chat IDs linked to PRJ-01; legacy TELEGRAM_PROJECT_CHAT_ID is also accepted
TELEGRAM_RP_USER_IDS=     # Comma-separated Telegram user IDs allowed to approve
TELEGRAM_MEMBER_USER_IDS= # Comma-separated Telegram user IDs allowed to send signals
# TELEGRAM_SPONSOR_USER_IDS= # Comma-separated read-only escalation recipients; never approval rights
# TELEGRAM_FOUNDER_USER_IDS= # Comma-separated sanitized new-connection notification recipients
# TELEGRAM_OWNER_USER_IDS_JSON= # JSON mapping exact task owner names to Telegram user IDs for private reminders
# TELEGRAM_API_BASE_URL=  # Optional controlled gateway or contract-test override; defaults to https://api.telegram.org
# TELEGRAM_GATEWAY_SECRET= # Shared key for the controlled /v1/telegram/* gateway; never expose publicly
# CONTACT_TELEGRAM_CHAT_ID= # Optional private landing-contact recipient; defaults to the first founder, then the first RP. The recipient must have started the bot.

# ── Platform AI gateway (injected by the platform; server-side only) ──
KIMI_AGENTGW_API_KEY=
KIMI_AGENTGW_BASE_URL=
