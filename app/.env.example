# PostgreSQL (Supabase → Database → Connection string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Supabase Auth (optional in BL1-0; enables 401 without session when set)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- BL-18 Official letters (prod: docs/ADR-BL-18-02-production-decisions.md) ---
# DEPLOYMENT_MODE=multi_tenant
# DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000002
# TENANT_STORAGE_QUOTA_BYTES=1073741824
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# LLM (OpenAI-compatible; Kimi / YandexGPT / др. — см. docs/specs/ADR-BL-18-02-production-decisions.md)
# Имя секрета везде: LLM_API_KEY (не KIMI_API_KEY — провайдер задаётся LLM_PROVIDER).
# BL-6 BL2-0 default (docs/specs/BL6_PRODUCT_DECISIONS.md §8):
# LLM_PROVIDER=kimi
# LLM_API_BASE_URL=https://api.moonshot.ai/v1
# LLM_MODEL_ID=moonshot-v1-8k
# LLM_API_KEY=
# RU_LLM_ALLOWLIST=api.yandex.net,llm.api.cloud.yandex.net
# ANTIVIRUS_MODE=required
# CLAMAV_HOST=127.0.0.1:3310
# ATTACHMENT_LLM_CHAR_LIMIT=12000
# BL18_ENABLED=true

# Signed cookie for Google tokens (generate random 32+ chars in prod)
# SESSION_SECRET=

# --- Local UI preview (npm run dev only; ignored in production) ---
# Google OAuth is required by default. Mock data without sign-in only if:
# BL6_DEV_SKIP_GOOGLE_AUTH=true

# --- BL-6 v2.2 (Google OAuth + SaluteSpeech, BL2-0) — docs/plans/BL2-0_SECRETS_SETUP.md ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# SALUTESPEECH_CLIENT_ID=
# SALUTESPEECH_SECRET=
# SALUTESPEECH_SCOPE=SALUTE_SPEECH_PERS
