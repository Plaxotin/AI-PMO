{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/app/api/$1" },
    { "src": "/assignments(.*)", "dest": "/app/assignments$1" },
    { "src": "/_next/(.*)", "dest": "/app/_next/$1" },
    { "src": "/favicon.ico", "dest": "/app/favicon.ico" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/app/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
