{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "app/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/api/projects/(.*)", "dest": "/app/api/projects/$1" },
    { "src": "/api/auth/(.*)", "dest": "/app/api/auth/$1" },
    { "src": "/(.*)", "dest": "/app/$1" }
  ],
  "functions": {
    "app/src/app/api/projects/[projectId]/ingest/route.ts": {
      "maxDuration": 300,
      "memory": 3008
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
